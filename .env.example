# Select one provider and model.
HIKING_MODEL=openai:gpt-6-luna
# HIKING_MODEL=ollama:gemma4:26b
OPENAI_API_KEY=
OPERATOR_URL=http://127.0.0.1:8765
# Optional SQLite path, shared by the planner and operator demo.
# ROUTE_CATALOG_DB=data/routes.sqlite3
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=picos-hiking
LANGSMITH_AGENT_ENVIRONMENT=local
# LANGSMITH_AGENT_ID=
# LANGSMITH_API_KEY=
# LANGSMITH_ENDPOINT=
# Runtime logs are separate from LangSmith and JSON trajectories.
LOG_LEVEL=INFO
# LOG_DIR=logs
